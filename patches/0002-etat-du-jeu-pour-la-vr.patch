diff --git a/engines/kyra/engine/lol.h b/engines/kyra/engine/lol.h
index 2cfadf37..a9028a26 100644
--- a/engines/kyra/engine/lol.h
+++ b/engines/kyra/engine/lol.h
@@ -32,6 +32,26 @@
 
 #include "common/list.h"
 
+// lol-vr: game state shared with the VR frontend. The frontend reads it through
+// retro_lolvr_state(), exported by the libretro core.
+extern "C" {
+struct LolvrGameState {
+	int32 version;
+	int32 level;        // current level number (0 before a game is started)
+	char tileset[16];   // level graphics set, e.g. "FOREST1"
+	uint32 sfxSerial;   // incremented each time a sound effect is played
+	int32 sfxTrack;
+	int32 sfxVolume;    // 0..255
+	uint32 hurtSerial;  // incremented each time a party member takes damage
+	int32 hurtDamage;
+	uint32 hitSerial;   // incremented each time the party damages a monster
+	int32 hitDamage;
+	char sfxName[16];   // sound file of the last effect, e.g. "DOORMTOP" (empty if none)
+	int32 reserved[4];  // [0] dungeon loop ticks, [1] control mode, [2] bit 0: automap open, bit 1: game menu open
+};
+extern LolvrGameState g_lolvrState;
+}
