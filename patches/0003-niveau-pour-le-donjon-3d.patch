+					}
+				g_lolvrLevel.placeType[slot] = type;
+				g_lolvrLevel.placeRgb = g_lolvrPlaceRgb;
+				g_lolvrLevel.placeSerial++;
+				ok = true;
+			}
+		}
+	}
+	delete[] data;
+	return ok;
+}
+
+void LoLEngine::lolvrLoadPlaces() {
+	g_lolvrLevel.placeCount = 0;
+	g_lolvrLevel.placeSerial++;
+	// Known from the start (each checked against the game's own picture on the wall): the places of
+	// the forests and of the swamp. Others are learnt when the game shows them.
+	static const struct { int level, type; const char *name; } kKnown[] = {
+		{2, 58, "KEEP.CPS"}, {2, 67, "KEEP.CPS"}, {2, 61, "MARINA2.CPS"},
+		{3, 56, "GREYEAGL.CPS"}, {3, 57, "BUCKHUT.CPS"}, {3, 59, "ROLRECK.CPS"}, {3, 60, "MARINA1.CPS"},
+		{11, 67, "KINGPAL.CPS"}, {11, 68, "WDRHUT.CPS"}, {11, 69, "SFLETCH.CPS"}, {11, 70, "SMITHY.CPS"}
+	};
+	for (const auto &k : kKnown)
+		if (k.level == _currentLevel)
+			lolvrExportPlace(k.type, k.name);
+	Common::InSaveFile *in = _saveFileMan->openForLoading(kLolvrPlacesFile);
+	if (!in)
+		return;
+	while (!in->eos() && !in->err()) {
+		Common::String line = in->readLine();
+		int lv = 0, type = 0;
+		char name[16] = {0};
+		if (sscanf(line.c_str(), "%d %d %15s", &lv, &type, name) == 3 && lv == _currentLevel && type > 0 && type < 256)
+			lolvrExportPlace(type, name);
+	}
+	delete in;
+}
+
+void LoLEngine::lolvrPlaceBitmap(const char *name) {
+	if (!_lolvrPlaceArmed || !name)
+		return;
+	_lolvrPlaceArmed = false;
+	const size_t len = strlen(name);
+	if (len < 5 || len > 15 || scumm_stricmp(name + len - 4, ".CPS"))
+		return;
+	auto picture = [&](uint8 t) { return t && !_wllVmpMap[t] && _wllShapeMap[t] > 0 && !(_wllWallFlags[t] & 0x89); };
+	// The picture the party faces, or the one of the block it just walked into (the face it crossed).
+	int type = 0;
+	const uint16 front = calcNewBlockPosition(_currentBlock, _currentDirection);
+	const uint8 *here = _levelBlockProperties[_currentBlock].walls;
+	if (picture(_levelBlockProperties[front].walls[_currentDirection ^ 2]))
+		type = _levelBlockProperties[front].walls[_currentDirection ^ 2];
+	else if (picture(here[_currentDirection ^ 2]))
+		type = here[_currentDirection ^ 2];
+	else
+		for (int k = 0; k < 4 && !type; k++)
+			if (picture(here[k]))
+				type = here[k];
+	if (!type || !lolvrExportPlace(type, name))
+		return;
+	// Remembered: the other places already known, and this one (in place of an older picture).
+	Common::Array<Common::String> lines;
+	if (Common::InSaveFile *in = _saveFileMan->openForLoading(kLolvrPlacesFile)) {
+		while (!in->eos() && !in->err()) {
+			Common::String line = in->readLine();
+			int lv = 0, t = 0;
+			if (sscanf(line.c_str(), "%d %d", &lv, &t) == 2 && !(lv == _currentLevel && t == type))
+				lines.push_back(line);
+		}
+		delete in;
+	}
+	lines.push_back(Common::String::format("%d %d %s", _currentLevel, type, name));
+	if (Common::OutSaveFile *out = _saveFileMan->openForSaving(kLolvrPlacesFile, false)) {
+		for (const Common::String &l : lines)
+			out->writeString(l + "\n");
+		out->finalize();
+		delete out;
+	}
+}
+
+void LoLEngine::lolvrPartyMoved() {
+	if (g_lolvrLevel.block == _currentBlock && g_lolvrLevel.direction == _currentDirection)
+		return;
+	g_lolvrLevel.block = _currentBlock;
+	g_lolvrLevel.direction = _currentDirection;
+	// The game draws the new view at once, with the scene that follows; in the headset the party
+	// turns or steps in the 3D dungeon, which takes a moment: a scene starting now waits for it.
+	if (!_needSceneRestore && !_dialogueField)
+		_lolvrTurnPending = true;
+}
+
+void LoLEngine::lolvrExportMap() {
+	LolvrLevelData &m = g_lolvrLevel;
+	bool changed = false;
+	const int32 avail = (_flagsTable[31] & 0x10) ? 1 : 0;
+	if (avail != m.mapAvailable || m.mapClass != _wllAutomapData) {
+		m.mapAvailable = avail;
+		m.mapClass = _wllAutomapData;
+		changed = true;
+	}
+	for (int i = 0; i < 1024; i++) {
+		const uint8 f = _levelBlockProperties[i].flags & 0x0F;
+		if (f != m.mapFlags[i]) {
+			m.mapFlags[i] = f;
+			changed = true;
+		}
+	}
+	// The title and the legend: again with each level, and in the language of the moment.
+	if (_lolvrMapLevel != _currentLevel || _lolvrMapLang != _lang) {
+		_lolvrMapLevel = _currentLevel;
+		_lolvrMapLang = _lang;
+		memset(m.mapTitle, 0, sizeof(m.mapTitle));
+		memset(m.mapLegendText, 0, sizeof(m.mapLegendText));
+		m.mapLegendCount = 0;
+		if (_autoMapStrings && _currentLevel > 0) {
+			if (const char *t = getLangString(_autoMapStrings[_currentLevel]))
+				Common::strlcpy(m.mapTitle, t, sizeof(m.mapTitle));
+		}
+		Common::String file = Common::String::format("level%d.xxx", _currentLevel);
+		uint32 size = 0;
+		uint8 *data = _res->exists(file.c_str()) ? _res->fileData(file.c_str(), &size) : nullptr;
+		if (data) {
+			const uint32 n = MIN<uint32>(size / 12, 32);
+			for (uint32 i = 0; i < n; i++) {
+				const uint8 *e = data + i * 12;
+				const uint16 mx = READ_LE_UINT16(e), my = READ_LE_UINT16(e + 2), shape = READ_LE_UINT16(e + 4);
+				const uint16 tx = READ_LE_UINT16(e + 6), ty = READ_LE_UINT16(e + 8), str = READ_LE_UINT16(e + 10);
+				if (tx == 0xFFFF || str == 0xFFFF || tx > 31 || ty > 31)
+					continue;
+				const int k = m.mapLegendCount++;
+				m.mapLegend[k][0] = (uint16)(tx + (ty << 5));
+				m.mapLegend[k][1] = (shape == 0xFFFF || mx > 31 || my > 31) ? 0xFFFF : (uint16)(mx + (my << 5));
+				m.mapLegend[k][2] = shape;
+				if (const char *t = getLangString(str))
+					Common::strlcpy(m.mapLegendText[k], t, sizeof(m.mapLegendText[k]));
+			}
+			delete[] data;
+		}
+		changed = true;
+	}
+	// The picture: the game's own atlas page, drawn again when anything on it changes.
+	if (avail && !_flags.use16ColorMode && (changed || _lolvrMapBlock != _currentBlock || _lolvrMapDir != _currentDirection || _lolvrMapWalls != m.wallsSerial)) {
+		_lolvrMapBlock = _currentBlock;
+		_lolvrMapDir = _currentDirection;
+		_lolvrMapWalls = m.wallsSerial;
+		lolvrRenderMap();
+		changed = true;
+	}
+	if (changed)
+		m.mapSerial++;
+}
+
+// lol-vr-3d: the atlas page as displayAutomap/drawMapPage draw it (the parchment, the map symbols,
+// the map fonts, the level's name, the legend and the party's arrow), on page 8 (the cursor's
+// scratch page, free between two cursor changes), then in colors into g_lolvrLevel.mapRgb. The
+// pieces the game loads when the atlas opens are loaded once and kept apart, so nothing of the
+// game's own state changes.
+void LoLEngine::lolvrRenderMap() {
+	if (!_lolvrMapParch) {
+		Palette pal(256);
+		_screen->loadBitmap("parch.cps", 8, 8, &pal);
+		_lolvrMapParch = new uint8[64000];
+		memcpy(_lolvrMapParch, _screen->getCPagePtr(8), 64000);
+		for (int i = 0; i < 768; i++)
+			_lolvrMapPal[i] = (uint8)((pal[i] & 63) * 255 / 63);
+		_screen->generateGrayOverlay(pal, _lolvrMapOvl, 52, 0, 0, 0, 256, false);
+		_screen->loadBitmap("autobut.shp", 8, 8, 0);
+		_lolvrMapShp = new uint8[64000];
+		memcpy(_lolvrMapShp, _screen->getCPagePtr(8), 64000);
+		for (int i = 0; i < 109; i++)
+			_lolvrMapShapes[i] = _screen->getPtrToShape(_lolvrMapShp, i + 11);
+		_screen->loadFont(Screen::FID_CRED8_FNT, "FONT9PN.FNT");
+		_screen->loadFont(Screen::FID_CRED6_FNT, "FONT6PN.FNT");
+		_lolvrMapRgb = new uint8[320 * 200 * 3];
+		g_lolvrLevel.mapRgb = _lolvrMapRgb;
+	}
+	const int8 xOffset = (_lang == 1) ? -2 : 0;
+	const uint8 **oldShapes = _automapShapes;
+	uint8 *oldOverlay = _mapOverlay;
+	_automapShapes = _lolvrMapShapes;
+	_mapOverlay = _lolvrMapOvl;
+	const int cp = _screen->setCurPage(8);
+	const Screen::FontId of = _screen->setFont(Screen::FID_CRED8_FNT);
+	// The party's arrow first, alone on the page (as redrawMapCursor does on page 2)
+	uint8 arrow[16 * 16];
+	_screen->fillRect(0, 0, 15, 15, 0, 8);
+	_screen->drawShape(8, _automapShapes[48 + (_currentDirection & 3)], 0, 0, 0, 0);
+	for (int y = 0; y < 16; y++)
+		memcpy(arrow + y * 16, _screen->getCPagePtr(8) + y * 320, 16);
+	for (int i = 0; i < 11; i++)
+		_defaultLegendData[i].enable = false;
+	// Twice, as the game: a place named in the legend marks its block seen for the second pass.
+	for (int pass = 0; pass < 2; pass++) {
+		memcpy(const_cast<uint8 *>(_screen->getCPagePtr(8)), _lolvrMapParch, 64000);
+		if (_lang == 1)
+			_screen->copyRegion(236, 16, 236 + xOffset, 16, -xOffset, 1, 8, 8, Screen::CR_NO_P_CHECK);
+		_screen->setFont(Screen::FID_CRED8_FNT);
+		if (_autoMapStrings)
+			_screen->printText(getLangString(_autoMapStrings[_currentLevel]), 236 + xOffset, 8, 1, 0);
+		const uint16 blX = mapGetStartPosX();
+		uint16 bl = (mapGetStartPosY() << 5) + blX;
+		int sx = _automapTopLeftX, sy = _automapTopLeftY;
+		for (; bl < 1024; bl++) {
+			uint8 *w = _levelBlockProperties[bl].walls;
+			if ((_levelBlockProperties[bl].flags & 7) == 7 && (!(_wllAutomapData[w[0]] & 0xC0)) && (!(_wllAutomapData[w[2]] & 0xC0)) && (!(_wllAutomapData[w[1]] & 0xC0)) && (!(_wllAutomapData[w[3]] & 0xC0))) {
+				const uint16 b0 = calcNewBlockPosition(bl, 0), b2 = calcNewBlockPosition(bl, 2);
+				const uint16 b1 = calcNewBlockPosition(bl, 1), b3 = calcNewBlockPosition(bl, 3);
+				const uint8 w02 = _levelBlockProperties[b0].walls[2], w20 = _levelBlockProperties[b2].walls[0];
+				const uint8 w13 = _levelBlockProperties[b1].walls[3], w31 = _levelBlockProperties[b3].walls[1];
+				_screen->copyBlockAndApplyOverlay(8, sx, sy, 8, sx, sy, 7, 6, 0, _mapOverlay);
+				drawMapBlockWall(b3, w31, sx, sy, 3);
+				drawMapShape(w31, sx, sy, 3);
+				if (_wllAutomapData[w31] & 0xC0)
+					_screen->copyBlockAndApplyOverlay(8, sx, sy, 8, sx, sy, 1, 6, 0, _mapOverlay);
+				drawMapBlockWall(b1, w13, sx, sy, 1);
+				drawMapShape(w13, sx, sy, 1);
+				if (_wllAutomapData[w13] & 0xC0)
+					_screen->copyBlockAndApplyOverlay(8, sx + 6, sy, 8, sx + 6, sy, 1, 6, 0, _mapOverlay);
+				drawMapBlockWall(b0, w02, sx, sy, 0);
+				drawMapShape(w02, sx, sy, 0);
+				if (_wllAutomapData[w02] & 0xC0)
+					_screen->copyBlockAndApplyOverlay(8, sx, sy, 8, sx, sy, 7, 1, 0, _mapOverlay);
+				drawMapBlockWall(b2, w20, sx, sy, 2);
+				drawMapShape(w20, sx, sy, 2);
+				if (_wllAutomapData[w20] & 0xC0)
+					_screen->copyBlockAndApplyOverlay(8, sx, sy + 5, 8, sx, sy + 5, 7, 1, 0, _mapOverlay);
+			}
+			sx += 7;
+			if (bl % 32 == 31) {
+				sx = _automapTopLeftX;
+				sy += 6;
+				bl += blX;
+			}
+		}
+		// The legend: the places whose block was seen, then the symbols met on the map.
+		_screen->setFont(Screen::FID_CRED6_FNT);
+		const int msx = mapGetStartPosX(), msy = mapGetStartPosY();
+		int tY = 0;
+		for (int ii = 0; ii < g_lolvrLevel.mapLegendCount && ii < 32; ii++) {
+			const uint16 *l = g_lolvrLevel.mapLegend[ii];
+			if ((_levelBlockProperties[l[0] & 1023].flags & 7) != 7)
+				continue;
+			_screen->printText(g_lolvrLevel.mapLegendText[ii], 244 + xOffset, (tY << 3) + 22, 239, 0);
+			if (l[1] != 0xFFFF) {
+				_levelBlockProperties[l[1] & 1023].flags |= 7;
+				_screen->drawShape(8, _automapShapes[l[2] << 2], ((l[1] & 31) - msx) * 7 + _automapTopLeftX - 3, ((l[1] >> 5) - msy) * 6 + _automapTopLeftY - 3, 0, 0);
+				_screen->drawShape(8, _automapShapes[l[2] << 2], 231 + xOffset, (tY << 3) + 19, 0, 0);
+			}
+			tY++;
+		}
+		for (int ii = 0; ii < 11; ii++) {
+			if (!_defaultLegendData[ii].enable)
+				continue;
+			_screen->copyBlockAndApplyOverlay(8, 235, (tY << 3) + 21, 8, 235 + xOffset, (tY << 3) + 21, 7, 6, 0, _mapOverlay);
+			_screen->drawShape(8, _automapShapes[_defaultLegendData[ii].shapeIndex << 2], 232 + xOffset, (tY << 3) + 18 + _defaultLegendData[ii].y, 0, 0);
+			_screen->printText(getLangString(_defaultLegendData[ii].stringId), 244 + xOffset, (tY << 3) + 22, 239, 0);
+			tY++;
+		}
+	}
+	// The arrow, in the colors of the blinking cursor (its first step)
+	{
+		const int sx = mapGetStartPosX(), sy = mapGetStartPosY();
+		const int cx = _automapTopLeftX + (((_currentBlock - sx) % 32) * 7) - 3;
+		const int cy = _automapTopLeftY + (((_currentBlock - (sy << 5)) / 32) * 6) - 2;
+		uint8 *page = const_cast<uint8 *>(_screen->getCPagePtr(8));
+		for (int y = 0; y < 16; y++)
+			for (int x = 0; x < 16; x++) {
+				const uint8 c = arrow[y * 16 + x];
+				const uint8 p = c ? (_mapCursorOverlay ? _mapCursorOverlay[c] : c) : 0;
+				if (p && cx + x >= 0 && cx + x < 320 && cy + y >= 0 && cy + y < 200)
+					page[(cy + y) * 320 + cx + x] = p;
+			}
+	}
+	const uint8 *page = _screen->getCPagePtr(8);
+	for (int i = 0; i < 64000; i++) {
+		const uint8 *c = _lolvrMapPal + page[i] * 3;
+		_lolvrMapRgb[i * 3] = c[0];
+		_lolvrMapRgb[i * 3 + 1] = c[1];
+		_lolvrMapRgb[i * 3 + 2] = c[2];
+	}
+	_screen->setFont(of);
+	_screen->setCurPage(cp);
+	_automapShapes = oldShapes;
+	_mapOverlay = oldOverlay;
+}
+
+// lol-vr-3d: the monsters near the party turn to face it, as they do when a scene (the thieves' demand)
+// starts: the game only draws them as they were, walking across. Returns true if any turned.
+bool LoLEngine::lolvrFaceMonsters() {
+	bool turned = false;
+	const int px = _currentBlock & 31, py = _currentBlock >> 5;
+	for (int i = 0; i < 30; i++) {
+		LoLMonster *m = &_monsters[i];
+		if (!m->properties || m->mode > 13 || m->hitPoints <= 0)
+			continue;
+		const int mx = m->block & 31, my = m->block >> 5;
+		if (ABS(mx - px) > 3 || ABS(my - py) > 3)
+			continue;
+		// Face à l'œil du joueur : à l'opposé de la direction du groupe (une direction du jeu en 8 : 2 par
+		// quart de tour), pas vers le point exact du groupe, qui le montrait de trois quarts.
+		const int dir = ((_currentDirection << 1) + 4) & 7;
+		if (m->direction == dir && m->facing == (dir >> 1))
+			continue;
+		m->direction = dir;
+		m->facing = dir >> 1;
+		m->destDirection = dir;
+		turned = true;
+	}
+	return turned;
+}
+
+void LoLEngine::lolvrTurnPause() {
+	// (the party's place as the scene starts, even when no script moved it: a step onto the block)
+	g_lolvrLevel.block = _currentBlock;
+	g_lolvrLevel.direction = _currentDirection;
+	const bool turned = lolvrFaceMonsters();
+	if (turned && g_lolvrLevel.gfxSerial && g_lolvrLevel.wallCaptureSerial == g_lolvrLevel.gfxSerial)
+		lolvrCaptureSprites(); // the monsters as they look now, facing the party
+	if (!_lolvrTurnPending && !turned)
+		return;
+	_lolvrTurnPending = false;
+	delay(turned ? 900 : 700, true);
+}
+
+void LoLEngine::lolvrExportLight() {
+	const Palette &cur = _screen->lolvrScreenPalette();
+	const Palette &base = _screen->getPalette(0);
+	uint32 lit = 0, full = 0;
+	for (int i = 3; i < 384; i++) {
+		lit += cur[i];
+		full += base[i];
+	}
+	g_lolvrLevel.light = full ? (int32)MIN<uint32>(256, lit * 256 / full) : 256;
+	// (_brightness: how dark the place is, 0 = lit; flag 31/8: the party carries a lit lantern)
+	if (!_brightness)
+		g_lolvrLevel.lamp = -1;
+	else if (!(_flagsTable[31] & 0x08) || !_lampOilStatus)
+		g_lolvrLevel.lamp = 8;
+	else
+		g_lolvrLevel.lamp = (3 - ((MIN<int>(_lampOilStatus, 100) - 1) / 25)) << 1;
+}
+
+void LoLEngine::lolvrExportWalls() {
+	bool changed = false;
+	for (int i = 0; i < 1024; i++)
+		for (int k = 0; k < 4; k++)
+			if (g_lolvrLevel.walls[i * 4 + k] != _levelBlockProperties[i].walls[k]) {
+				g_lolvrLevel.walls[i * 4 + k] = _levelBlockProperties[i].walls[k];
+				changed = true;
+			}
+	if (changed)
+		g_lolvrLevel.wallsSerial++;
+}
+
+void LoLEngine::lolvrInventoryService() {
+	const int op = g_lolvrInvOp, arg = g_lolvrInvArg;
+	g_lolvrInvOp = -1;
+	if (op == 3) {
+		// The next spell of the scroll (L3 in the headset), as a click on its line would choose it.
+		if (_dialogueField || _currentControlMode || _needSceneRestore)
+			return;
+		int next = _selectedSpell;
+		for (int k = 1; k <= 7; k++) {
+			const int i = (_selectedSpell + k) % 7;
+			if (_availableSpells[i] != -1) {
+				next = i;
+				break;
+			}
+		}
+		if (next != _selectedSpell) {
+			const int cp = _screen->setCurPage(0);
+			gui_highlightSelectedSpell(false);
+			_selectedSpell = next;
+			gui_highlightSelectedSpell(true);
+			gui_drawAllCharPortraitsWithStats();
+			_screen->setCurPage(cp);
+			_screen->updateScreen();
+		}
+		return;
+	}
+	if (op == 5) {
+		// As clickedScenePickupItem does, without looking for the item's pixels on the screen.
+		if ((_updateFlags & 1) || _itemInHand || _currentControlMode || _needSceneRestore || _dialogueField)
+			return;
+		if (arg <= 0 || arg >= 400 || !_itemsInPlay || _itemsInPlay[arg].flyingHeight)
+			return;
+		const uint16 ahead = calcNewBlockPosition(_currentBlock, _currentDirection);
+		const uint16 block = _itemsInPlay[arg].block;
+		if (block != _currentBlock && block != ahead)
+			return;
+		bool here = false;
+		for (uint16 *o = &_levelBlockProperties[block].drawObjects; *o; o = &findObject(*o)->nextDrawObject)
+			if (*o == (uint16)arg) {
+				here = true;
+				break;
+			}
+		if (!here)
+			return;
+		removeLevelItem(arg, block);
+		setHandItem(arg);
+		_sceneUpdateRequired = true;
+		return;
+	}
+	if (!g_lolvrInvMode)
+		return;
+	_inventoryCurItem = 0; // new items go to the first free slot, the quick bar first
+	if (op == 1 && arg >= 0 && arg < 48) {
+		// (as in the game: also in a shop or a conversation, to put away what was bought or given)
+		if (_currentControlMode && _needSceneRestore)
+			return;
+		Button b;
+		b.arg = 0;
+		b.x = 0x6A;
+		b.y = 179;
+		_inventoryCurItem = arg;
+		clickedInventorySlot(&b);
+		_inventoryCurItem = 0;
+		gui_drawInventory();
+	} else if (op == 2) {
+		Common::Array<Item> items;
+		const int first = 16; // (les deux lignes rapides, 0-15, ne sont pas triées)
+		for (int i = first; i < 48; i++)
+			if (_inventory[i])
+				items.push_back(_inventory[i]);
+		for (uint a = 1; a < items.size(); a++) {
+			Item it = items[a];
+			const ItemProperty &pa = _itemProperties[_itemsInPlay[it].itemPropertyIndex];
+			uint b = a;
+			while (b > 0) {
+				const Item o = items[b - 1];
+				const ItemProperty &pb = _itemProperties[_itemsInPlay[o].itemPropertyIndex];
+				const bool before = pa.type != pb.type ? pa.type < pb.type : _itemsInPlay[it].itemPropertyIndex < _itemsInPlay[o].itemPropertyIndex;
+				if (!before)
+					break;
+				items[b] = o;
+				b--;
+			}
+			items[b] = it;
+		}
+		for (int i = first; i < 48; i++)
+			_inventory[i] = (uint)(i - first) < items.size() ? items[i - first] : 0;
+		gui_drawInventory();
+	}
+}
+
+void LoLEngine::lolvrExportInventory() {
+	static const int kCell = 22, kCols = 8, kRows = 6, kW = kCols * kCell, kH = kRows * kCell;
+	static uint8 rgb[kW * kH * 3];
+	static uint32 serial = 0, lastHash = 0;
+	g_lolvrLevel.invRgb = rgb;
+	if (!g_lolvrInvMode || !_screen || !_itemsInPlay || !_itemProperties)
+		return;
+	const uint8 *pal = _screen->getPalette(0).getData();
+	uint32 hash = 17;
+	for (int i = 0; i < 48; i++)
+		hash = hash * 31 + _inventory[i] + (_inventory[i] ? _itemsInPlay[_inventory[i]].itemPropertyIndex * 977 : 0);
+	for (int i = 0; i < 768; i += 7)
+		hash = hash * 31 + pal[i];
+	if (hash == lastHash && serial)
+		return;
+	lastHash = hash;
+	static uint8 backup[kW * kH];
+	_screen->copyRegionToBuffer(_sceneDrawPage1, 112, 0, kW, kH, backup);
+	for (int i = 0; i < 48; i++) {
+		const int x = 112 + (i % kCols) * kCell, y = (i / kCols) * kCell;
+		_screen->drawShape(_sceneDrawPage1, _gameShapes[4], x, y, 0, (((i % kCols) + (i / kCols)) & 1) ? 0 : 1);
+		if (_inventory[i])
+			_screen->drawShape(_sceneDrawPage1, getItemIconShapePtr(_inventory[i]), x + 1, y + 1, 0, 0);
+	}
+	const uint8 *page = _screen->getCPagePtr(_sceneDrawPage1);
+	for (int y = 0; y < kH; y++)
+		for (int x = 0; x < kW; x++) {
+			const uint8 c = page[y * 320 + 112 + x];
+			uint8 *o = rgb + (y * kW + x) * 3;
+			for (int k = 0; k < 3; k++) {
+				const uint8 v = pal[c * 3 + k] & 0x3F;
+				o[k] = (v << 2) | (v >> 4);
+			}
+		}
+	_screen->copyBlockToPage(_sceneDrawPage1, 112, 0, kW, kH, backup);
+	g_lolvrLevel.invSerial = ++serial;
+}
