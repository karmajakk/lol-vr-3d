+// lol-vr-3d: draws one monster or item at full size, centred at (200, 60) in the scene window of
+// _sceneDrawPage1, the way drawMonster() and drawBlockObjects() choose its picture.
+bool LoLEngine::lolvrDrawSprite(uint16 id, uint8 &ceiling) {
+	ceiling = 0;
+	uint8 *shp = 0;
+	uint8 *monsterPalette = 0;
+	int flags = 0;
+	bool flip = false;
+	LoLMonster *m = 0;
+	int curFrm = 0;
+	if (id & 0x8000) {
+		m = &_monsters[id & 0x7FFF];
+		if (!m->properties)
+			return false;
+		int16 flg = _monsterDirFlags[(_currentDirection << 2) + m->facing];
+		curFrm = getMonsterCurFrame(m, flg & 0xFFEF);
+		if (curFrm == -1)
+			return false;
+		int d = m->flags & 7;
+		flip = (m->properties->flags & 0x200) != 0;
+		flags = (flg & 0x10) | 1;
+		shp = _monsterShapes[(m->properties->shapeIndex << 4) + curFrm];
+		if (!shp)
+			return false;
+		if (m->properties->flags & 0x800)
+			flags |= 0x20;
+		monsterPalette = d ? _monsterPalettes[(m->properties->shapeIndex << 4) + (curFrm & 0x0F)] + (shp[10] * (d - 1)) : 0;
+		ceiling = flip ? 1 : 0;
+	} else {
+		LoLItem *i = &_itemsInPlay[id];
+		const ItemProperty &p = _itemProperties[i->itemPropertyIndex];
+		shp = (p.flags & 0x40) ? _gameShapes[p.shpIndex] : _itemShapes[_gameShapeMap[p.shpIndex << 1]];
+		if (!shp)
+			return false;
+	}
+
+	uint8 *ovl2 = _screen->getLevelOverlay(_flags.use16ColorMode ? 5 : 4);
+	uint8 *bright = _screen->getLevelOverlay(7);
+	int flg = flags & 0x10 ? 1 : 0;
+	if (flags & 0x20)
+		flg |= 0x1000;
+	if (flip)
+		flg |= 2;
+	if (!_flags.use16ColorMode && _currentLevel != 22)
+		flg |= 0x2000;
+	_dmScaleW = _dmScaleH = 0x100;
+	_shpDmX = 200;
+	_shpDmY = 60;
+	if (flg & 0x1000) {
+		if (monsterPalette)
+			_screen->drawShape(_sceneDrawPage1, shp, _shpDmX, _shpDmY, 13, flg | 0x8124, monsterPalette, bright, 0, _transparencyTable1, _transparencyTable2, _dmScaleW, _dmScaleH, ovl2);
+		else
+			_screen->drawShape(_sceneDrawPage1, shp, _shpDmX, _shpDmY, 13, flg | 0x124, bright, 0, _transparencyTable1, _transparencyTable2, _dmScaleW, _dmScaleH, ovl2);
+	} else {
+		if (monsterPalette)
+			_screen->drawShape(_sceneDrawPage1, shp, _shpDmX, _shpDmY, 13, flg | 0x8124, monsterPalette, bright, 1, _dmScaleW, _dmScaleH, ovl2);
+		else
+			_screen->drawShape(_sceneDrawPage1, shp, _shpDmX, _shpDmY, 13, flg | 0x124, bright, 1, _dmScaleW, _dmScaleH, ovl2);
+	}
+	if (m) {
+		// Weapons and armour of the monster, drawn over it like the game does
+		_shpDmX -= (_screen->getShapeScaledWidth(shp, _dmScaleW) >> 1);
+		_shpDmY -= (_screen->getShapeScaledHeight(shp, _dmScaleH) >> 1);
+		for (int k = 0; k < 4; k++) {
+			int v = m->equipmentShapes[k] - 1;
+			if (v == -1)
+				break;
+			uint8 *shp2 = _monsterDecorationShapes[m->properties->shapeIndex * 192 + v * 48 + curFrm * 3];
+			if (shp2)
+				drawDoorOrMonsterEquipment(shp2, 0, _shpDmX, _shpDmY, (flags & 0x30) | 1, bright);
+		}
+	}
+	return true;
+}
+
+// lol-vr-3d: every monster and item within a few blocks of the party, drawn at full size into a
+// private buffer for the 3D dungeon. The scene window is saved and put back, so the game never sees it.
+void LoLEngine::lolvrCaptureSprites() {
+	static const int kW = 176, kH = 120, kMax = 32, kRange = 5;
+	static uint8 pixels[kMax * kW * kH];
+	static uint8 alpha[kMax * kW * kH];
+	static uint8 first[kW * kH];
+	static uint8 backup[kW * kH];
+	static uint32 serial = 0;
+
+	g_lolvrLevel.spritePixels = pixels;
+	g_lolvrLevel.spriteAlpha = alpha;
+	if (!_monsters || !_itemsInPlay || !_levelBlockProperties || !_screen)
+		return;
+
+	// Which objects: walk the blocks around the party
+	uint16 ids[kMax];
+	int count = 0;
+	int px = _currentBlock & 31, py = _currentBlock >> 5;
+	for (int by = py - kRange; by <= py + kRange && count < kMax; by++) {
+		for (int bx = px - kRange; bx <= px + kRange && count < kMax; bx++) {
+			if (bx < 0 || bx > 31 || by < 0 || by > 31)
+				continue;
+			uint16 s = _levelBlockProperties[by * 32 + bx].assignedObjects;
+			int guard = 0;
+			while (s && count < kMax && guard++ < 64) {
+				ids[count++] = s;
+				s = findObject(s)->nextAssignedObject;
+			}
+		}
+	}
+
+	_screen->copyRegionToBuffer(_sceneDrawPage1, 112, 0, kW, kH, backup);
+	int savedX = _shpDmX, savedY = _shpDmY;
+	uint16 savedW = _dmScaleW, savedH = _dmScaleH;
+	drawLevelModifyScreenDim(13, 14, 0, 36, 15);
+	const uint8 *page = _screen->getCPagePtr(_sceneDrawPage1);
+
+	int n = 0;
+	for (int k = 0; k < count; k++) {
+		uint16 id = ids[k];
+		LoLObject *o = findObject(id);
+		LolvrSprite &sp = g_lolvrLevel.sprites[n];
+		uint8 *spx = pixels + n * kW * kH, *sal = alpha + n * kW * kH;
+		uint8 ceiling = 0;
+		bool drawn = true;
+		for (int pass = 0; pass < 2 && drawn; pass++) {
+			uint8 fill = pass ? 0xFE : 0x01;
+			_screen->fillRect(112, 0, 112 + kW - 1, kH - 1, fill, _sceneDrawPage1);
+			drawn = lolvrDrawSprite(id, ceiling);
+			for (int y = 0; y < kH && drawn; y++)
+				for (int x = 0; x < kW; x++) {
+					uint8 c = page[y * 320 + 112 + x];
+					if (!pass) {
+						first[y * kW + x] = c;
+					} else {
+						bool cov = c == first[y * kW + x] && c != fill;
+						spx[y * kW + x] = cov ? c : 0;
+						sal[y * kW + x] = cov ? 255 : 0;
+					}
+				}
+		}
+		if (!drawn)
+			continue;
+		int x0 = kW, y0 = kH, x1 = 0, y1 = 0;
+		uint32 sum = 0;
+		for (int y = 0; y < kH; y++)
+			for (int x = 0; x < kW; x++)
+				if (sal[y * kW + x]) {
+					x0 = MIN(x0, x); y0 = MIN(y0, y); x1 = MAX(x1, x + 1); y1 = MAX(y1, y + 1);
+					sum = sum * 31 + spx[y * kW + x] + (uint32)(x + y * kW);
+				}
+		if (x1 <= x0)
+			continue;
+		int shift = (id & 0x8000) ? _monsters[id & 0x7FFF].shiftStep : 0;
+		sp.x = o->x + ((id & 0x8000) ? _monsterShiftOffs[shift << 1] : 0);
+		sp.y = o->y + ((id & 0x8000) ? _monsterShiftOffs[(shift << 1) + 1] : 0);
+		sp.kind = (id & 0x8000) ? 0 : 1;
+		sp.ceiling = ceiling;
+		sp.x0 = x0; sp.y0 = y0; sp.x1 = x1; sp.y1 = y1;
+		sp.version = sum;
+		sp.id = id;
+		n++;
+	}
+	g_lolvrLevel.spriteCount = n;
+	g_lolvrLevel.spriteSerial = ++serial;
+
+	_screen->copyBlockToPage(_sceneDrawPage1, 112, 0, kW, kH, backup);
+	_shpDmX = savedX; _shpDmY = savedY;
+	_dmScaleW = savedW; _dmScaleH = savedH;
+}
+
 } // End of namespace Kyra
 
