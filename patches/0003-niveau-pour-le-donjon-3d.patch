+// lol-vr-3d: draws each wall type of the level the way the game shows a wall right in front of
+// the party, one step away, with its decorations and door, into a private buffer. The scene is
+// redrawn afterwards, so nothing of this reaches the screen.
+void LoLEngine::lolvrCaptureWalls() {
+	static const int kW = 128, kH = 96, kMaxSlots = 96;
+	static uint8 pixels[kMaxSlots * kW * kH];
+	static uint8 alpha[kMaxSlots * kW * kH];
+	static uint8 shapeA[kW * kH];
+	static uint8 doorPx[kMaxSlots * kW * kH];
+	static uint8 doorAl[kMaxSlots * kW * kH];
+
+	g_lolvrLevel.wallCaptureSerial = g_lolvrLevel.gfxSerial;
+	for (int i = 0; i < 256; i++)
+		g_lolvrLevel.wallSlot[i] = -1;
+	g_lolvrLevel.wallSlots = 0;
+	g_lolvrLevel.wallPixels = pixels;
+	g_lolvrLevel.wallAlpha = alpha;
+	g_lolvrLevel.doorPixels = doorPx;
+	g_lolvrLevel.doorAlpha = doorAl;
+	if (!_vmpPtr || !_vcnBlocks || !_blockDrawingBuffer || !_sceneWindowBuffer)
+		return;
+	memcpy(g_lolvrLevel.screenPalette, _screen->getPalette(0).getData(), 768);
+
+	LevelBlockProperty fake[2];
+	memset(fake, 0, sizeof(fake));
+	LevelBlockProperty *savedVis[18];
+	memcpy(savedVis, _visibleBlocks, sizeof(savedVis));
+	int16 savedVisIdx[18];
+	memcpy(savedVisIdx, _visibleBlockIndex, sizeof(savedVisIdx));
+	uint8 savedProcessFlag = _wllProcessFlag;
+	_wllProcessFlag = 0;
+	_sceneDrawVarDown = _dscBlockMap[_currentDirection];
+	_sceneDrawVarRight = _dscBlockMap[_currentDirection + 4];
+	_sceneDrawVarLeft = _dscBlockMap[_currentDirection + 8];
+
+	const uint8 *page = _screen->getCPagePtr(_sceneDrawPage1);
+	const int x0 = 112 + 24, y0 = 8; // the wall right in front, in the 176 x 120 view at x = 112
+
+	for (int t = 1; t < 256 && g_lolvrLevel.wallSlots < kMaxSlots; t++) {
+		if (!_wllVmpMap[t] && _wllShapeMap[t] <= 0 && !(_wllWallFlags[t] & 8))
+			continue;
+		int slot = g_lolvrLevel.wallSlots++;
+		g_lolvrLevel.wallSlot[t] = slot;
+		uint8 *px = pixels + slot * kW * kH;
+		uint8 *al = alpha + slot * kW * kH;
+		memset(px, 0, kW * kH);
+		memset(al, 0, kW * kH);
+		uint8 *dpx = doorPx + slot * kW * kH;
+		uint8 *dal = doorAl + slot * kW * kH;
+		memset(dpx, 0, kW * kH);
+		memset(dal, 0, kW * kH);
+
+		for (int i = 0; i < 18; i++) {
+			_visibleBlocks[i] = &fake[0];
+			_visibleBlockIndex[i] = _currentBlock;
+			_lvlShapeLeftRight[i] = _lvlShapeLeftRight[18 + i] = -1;
+		}
+		for (int k = 0; k < 4; k++)
