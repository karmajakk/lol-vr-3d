+			for (int i = 0; i < g_lolvrLevel.placeCount; i++)
+				if (g_lolvrLevel.placeType[i] == type)
+					slot = i;
+			if (slot < 0 && g_lolvrLevel.placeCount < 16)
+				slot = g_lolvrLevel.placeCount++;
+			if (slot >= 0) {
+				uint8 *dst = g_lolvrPlaceRgb + slot * 176 * 120 * 3;
+				for (int y = 0; y < 120; y++)
+					for (int x = 0; x < 176; x++) {
