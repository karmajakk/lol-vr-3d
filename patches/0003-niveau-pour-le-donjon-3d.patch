diff --git a/engines/kyra/engine/lol.h b/engines/kyra/engine/lol.h
index a9028a26..5d58ca6b 100644
--- a/engines/kyra/engine/lol.h
+++ b/engines/kyra/engine/lol.h
@@ -50,6 +50,30 @@ struct LolvrGameState {
 	int32 reserved[4];  // [0] dungeon loop ticks, [1] control mode, [2] bit 0: automap open, bit 1: game menu open
 };
 extern LolvrGameState g_lolvrState;
+
+// lol-vr-3d: the current level, for the 3D dungeon. The frontend reads it through
+// retro_lolvr_level(). The pointers stay valid until gfxSerial changes.
+struct LolvrLevelData {
+	int32 version;          // 1
+	uint32 gfxSerial;       // incremented each time level graphics are (re)loaded
+	uint32 wallsSerial;     // incremented each time the walls array below changes
+	int32 level;            // 0 = no level loaded
+	int32 block;            // party position: block index (y * 32 + x)
+	int32 direction;        // 0 north, 1 east, 2 south, 3 west
+	int32 inDungeon;        // 1 while the dungeon loop runs
+	uint8 walls[1024 * 4];  // wall type of each side (N, E, S, W) of each block
+	const uint8 *wllVmpMap; // 256: wall type -> VMP page (0 = nothing drawn)
+	const uint8 *wllWallFlags; // 256
+	const int8 *wllShapeMap;   // 256: wall type -> decoration
+	const uint16 *vmp;      // VMP table
+	int32 vmpLen;
+	const uint8 *vcnBlocks; // 8x8 blocks, 4 bits per pixel (32 bytes each)
+	const uint8 *vcnShift;  // per block palette shift
+	int32 vcnCount;
+	const uint8 *vcnColTable; // 128
+	uint8 palette[384];     // 128 colours, 6-bit VGA
+};
+extern LolvrLevelData g_lolvrLevel;
 }
 
