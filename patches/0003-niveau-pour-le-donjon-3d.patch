+bool LoLEngine::lolvrExportPlace(int type, const char *name) {
+	uint32 size = 0;
+	uint8 *data = _res->fileData(name, &size);
+	if (!data)
+		return false;
+	bool ok = false;
+	if (size > 10) {
+		const uint8 comp = data[2];
+		const uint32 imgSize = READ_LE_UINT32(data + 4);
+		const uint16 palSize = READ_LE_UINT16(data + 8);
