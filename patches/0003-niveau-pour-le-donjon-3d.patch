+void LoLEngine::lolvrApplyLangRequest() {
+	const int req = g_lolvrLangRequest;
+	g_lolvrLangRequest = -1;
+	if (req < 0 || req == _lang || _langIntern || !_flags.isTalkie)
+		return;
+	_lang = req;
+	Common::String filename = Common::String::format("LEVEL%02d.%s", _currentLevel, _languageExt[_lang]);
+	delete[] _levelLangFile;
+	_levelLangFile = resource()->fileData(filename.c_str(), 0);
+	filename = Common::String::format("LANDS.%s", _languageExt[_lang]);
+	delete[] _landsFile;
+	_landsFile = resource()->fileData(filename.c_str(), 0);
+}
