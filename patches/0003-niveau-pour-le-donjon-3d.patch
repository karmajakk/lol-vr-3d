+			_visibleBlocks[i] = &fake[0];
+			_visibleBlockIndex[i] = _currentBlock;
+			_lvlShapeLeftRight[i] = _lvlShapeLeftRight[18 + i] = -1;
+		}
+		for (int k = 0; k < 4; k++)
+			fake[1].walls[k] = t;
+		_visibleBlocks[13] = &fake[1];
+
+		// 1. The wall itself, from the VMP/VCN blocks. Some wall types of the table are not used by
+		// the level and point past its VMP/VCN data (Roland's manor): they are left out.
+		bool vmpOk = _wllVmpMap[t] != 0;
+		if (vmpOk) {
+			const int base = (_wllVmpMap[t] - 1) * 431 + _vmpVisOffs[7] + 330;
+			if (base < 0 || base + 16 * 12 > g_lolvrLevel.vmpLen) {
+				vmpOk = false;
+			} else {
+				for (int i = 0; i < 16 * 12 && vmpOk; i++) {
+					const int e = _vmpPtr[base + i] & 0x3FFF;
+					if (e >= g_lolvrLevel.vcnCount)
+						vmpOk = false;
+				}
+			}
+		}
+		if (vmpOk) {
+			memset(_blockDrawingBuffer, 0, 660 * sizeof(uint16));
+			generateVmpTileData(3, 1, t, _vmpVisOffs[7], 16, 12);
+			drawVcnBlocks();
+			const uint16 *vmp = &_vmpPtr[(_wllVmpMap[t] - 1) * 431 + _vmpVisOffs[7] + 330];
+			for (int y = 0; y < kH; y++)
+				for (int x = 0; x < kW; x++) {
+					uint16 v = vmp[(y >> 3) * 16 + (x >> 3)];
+					bool covered = v != 0;
+					if (v & 0x8000) {
+						// wall block over the background: its colour 0 is see-through
+						uint16 e = v & 0x3FFF;
+						int bx = (v & 0x4000) ? 7 - (x & 7) : (x & 7);
+						uint8 b = _vcnBlocks[e * 32 + (y & 7) * 4 + (bx >> 1)];
+						covered = ((bx & 1) ? (b & 15) : (b >> 4)) != 0;
+					}
+					if (covered) {
+						px[y * kW + x] = page[(y0 + y) * 320 + x0 + x];
+						al[y * kW + x] = 255;
+					}
+				}
+		}
+
+		// 2. Decorations (on the face), then the door (alone), each drawn twice over two plain
+		// fills: a pixel the shapes cover keeps the same colour in both. A door that is opening or
+		// closing (raised by v) is captured closed; the third part draws it where it really is,
+		// only to measure how far up it went (doorRaise, rows of the capture).
+		const bool isDoor = (_wllWallFlags[t] & 8) != 0;
+		int doorV = 0;
+		if (isDoor) {
+			doorV = 20 * (t - (t < 23 ? _dscDoorScaleOffs[t] : 0));
+			if (doorV > 80)
+				doorV = 80;
+		}
+		int footClosed = -1, footRaised = -1;
+		g_lolvrLevel.doorRaise[t] = 0;
+		for (int part = 0; part < (doorV > 0 ? 3 : 2); part++) {
+			for (int pass = 0; pass < 2; pass++) {
+				uint8 fill = pass ? 0xFE : 0x01;
+				_screen->fillRect(112, 0, 112 + 175, 119, fill, _sceneDrawPage1);
+				_shpDmX1 = 0;
+				_shpDmX2 = 0;
+				setLevelShapesDim(13, _shpDmX1, _shpDmX2, _sceneShpDim);
+				if (_shpDmX2 > _shpDmX1) {
+					if (part == 0) {
+						drawDecorations(13);
+					} else if (isDoor) {
+						int16 dimY1 = 0, dimY2 = 0;
+						setDoorShapeDim(13, dimY1, dimY2, _sceneShpDim);
+						drawDoor(_doorShapes[(t < 23 ? _dscDoorShpIndex[t] : 0)], 0, 13, 10, 0, part == 2 ? -doorV : 0, 2);
+						setLevelShapesDim(13, dimY1, dimY2, _sceneShpDim);
+					}
+				}
+				for (int y = 0; y < kH; y++)
+					for (int x = 0; x < kW; x++) {
+						uint8 c = page[(y0 + y) * 320 + x0 + x];
+						if (!pass) {
+							shapeA[y * kW + x] = c;
+						} else if (c == shapeA[y * kW + x] && c != fill) {
+							if (part == 2) {
+								footRaised = y;
+								continue;
+							}
+							if (part == 1)
+								footClosed = y;
+							(part ? dpx : px)[y * kW + x] = c;
+							(part ? dal : al)[y * kW + x] = 255;
+						}
+					}
+			}
+		}
+		if (doorV > 0 && footClosed >= 0) {
+			int r = footRaised >= 0 ? footClosed - footRaised : footClosed + 1;
+			g_lolvrLevel.doorRaise[t] = (uint8)CLIP(r, 1, 255);
+		}
+	}
+
+	memcpy(_visibleBlocks, savedVis, sizeof(savedVis));
+	memcpy(_visibleBlockIndex, savedVisIdx, sizeof(savedVisIdx));
+	_wllProcessFlag = savedProcessFlag;
+	assignVisibleBlocks(_currentBlock, _currentDirection);
+	_sceneUpdateRequired = true;
+}
+
 } // End of namespace Kyra
 
 #endif // ENABLE_LOL
