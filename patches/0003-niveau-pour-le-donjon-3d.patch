+void LoLEngine::lolvrSpellBegin() {
+	_screen->copyRegionToBuffer(0, 112, 0, 176, 120, g_lolvrSpellRef);
+	memset(g_lolvrSpellAl, 0, sizeof(g_lolvrSpellAl));
+	g_lolvrLevel.spellPixels = g_lolvrSpellPx;
+	g_lolvrLevel.spellAlpha = g_lolvrSpellAl;
+	g_lolvrLevel.spellBusy = 1;
+	g_lolvrLevel.spellSerial++;
+	g_lolvrEngine = this;
+}
+
+void LoLEngine::lolvrSpellUpdate() {
+	const uint8 *page = _screen->getCPagePtr(0);
+	if (!page)
+		return;
+	for (int y = 0; y < 120; y++)
+		for (int x = 0; x < 176; x++) {
+			uint8 c = page[y * 320 + 112 + x];
+			bool fx = c != g_lolvrSpellRef[y * 176 + x];
+			g_lolvrSpellPx[y * 176 + x] = fx ? c : 0;
+			g_lolvrSpellAl[y * 176 + x] = fx ? 255 : 0;
+		}
+	g_lolvrLevel.spellSerial++;
+}
+
+void LoLEngine::lolvrSpellEnd() {
+	g_lolvrLevel.spellBusy = 0;
+	g_lolvrLevel.spellSerial++;
+	g_lolvrEngine = nullptr;
+}
