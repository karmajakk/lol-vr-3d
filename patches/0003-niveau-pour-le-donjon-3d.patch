+struct LolvrSprite {
+	int16 x, y;        // position in the level: block x * 256 + fine x (same for y)
+	uint8 kind;        // 0 monster, 1 item
+	uint8 ceiling;     // hangs from the ceiling
+	int16 x0, y0, x1, y1; // drawn part of the picture (x1, y1 excluded)
+	uint32 version;    // changes when the picture changes
